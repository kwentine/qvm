#!/usr/bin/env bash
#+ Generate the cloud-init NoCloud datasource files for VM.
#+
#+ The template used is QVM_CONFIG_DIR/user-data/VM.yaml,
#+ in which occurrences of ${QVM_HOST} are replaced by VM.
#+
#+ Usage: SCRIPT [-h] VM
set -eu
SCRIPT="$(basename "$0")"
SCRIPT_DIR="$(dirname "$0")"
# shellcheck source-path=SCRIPTDIR
source "${SCRIPT_DIR}/libqvm.sh"

LOCALDS_DIR="${QVM_DATA_DIR}/localds"
USERDATA_DIR="${QVM_CONFIG_DIR}/user-data"

while getopts h opt; do
  case "${opt}" in
    *)
      usage "${opt}"
      ;;
  esac
done
shift $((OPTIND - 1))

[[ -n "${1:-}" ]] || usage

vm="${1}"
printf -v user_data '%s/%s.yaml' "${USERDATA_DIR}" "${vm}"
[[ -f "${user_data}" ]] || errexit "no such file: ${user_data}"

seed_dir="${LOCALDS_DIR}/${vm}"
mkdir -p "${seed_dir}"
# Substitute only QVM_HOST: other $VARIABLES (e.g. in runcmd) are for the guest
# shellcheck disable=SC2016
QVM_HOST="${vm}" envsubst '${QVM_HOST}' <"${user_data}" >"${seed_dir}/user-data"
# A new instance-id makes cloud-init treat the next boot as a first boot
cat >"${seed_dir}/meta-data" <<EOF
instance-id: qvm-${vm}-${RANDOM}
local-hostname: ${vm}
EOF
info "Created datasource: ${seed_dir}"
