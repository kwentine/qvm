[Unit]
Description=Bring up bridge qvm0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/qvm/bin/qvm-bridge up
# Route DNS queries for the VM domains to dnsmasq on qvm0.
# With NetworkManager, config/qvm0.nmconnection does the same.
ExecStartPost=resolvectl dns qvm0 10.42.0.1
ExecStartPost=resolvectl domain qvm0 qvm0.lan ~qvm.lan
ExecStartPost=resolvectl default-route qvm0 no
ExecStartPost=resolvectl llmnr qvm0 no
ExecStartPost=resolvectl dnssec qvm0 no
ExecStop=/opt/qvm/bin/qvm-bridge down
