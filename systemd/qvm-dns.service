[Unit]
Description=Start dnsmasq server on interface qvm0
# udev exposes every network interface as a device unit, whoever creates it
# (NetworkManager, `ip link add`...):
# start once qvm0 exists, stop when it disappears.
BindsTo=sys-subsystem-net-devices-qvm0.device
After=sys-subsystem-net-devices-qvm0.device

[Service]
Type=exec
ExecStart=dnsmasq --keep-in-foreground --conf-file=/etc/opt/qvm/dnsmasq.conf

[Install]
# Start whenever qvm0 appears
WantedBy=sys-subsystem-net-devices-qvm0.device
